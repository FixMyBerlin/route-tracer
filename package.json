{
  "name": "route-tracer",
  "version": "0.0.0",
  "private": true,
  "description": "Trace existing routes from reference images into OSM-snapped map geometry",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests src",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check-pre-push": "bun run --parallel type-check lint format test-run knip",
    "e2e": "playwright test --project=chromium",
    "prepare": "husky"
  },
  "dependencies": {
    "@maptiler/geocoding-control": "^3.0.0",
    "@osm-editor-kit/osm-coverage": "0.1.0-alpha.2",
    "@osm-editor-kit/osm-data": "0.1.0-alpha.0",
    "@osm-editor-kit/osm-map-url": "0.1.0-alpha.0",
    "@osm-editor-kit/osm-maplibre": "0.1.0-alpha.0",
    "@osm-editor-kit/osm-route-snapper": "0.1.0-alpha.0",
    "@osm-editor-kit/osm-way-chain": "0.1.0-alpha.2",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@turf/difference": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5",
    "@turf/simplify": "^7.3.5",
    "date-fns": "^4.4.0",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^5.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "route-snapper": "0.4.9",
    "route-snapper-ts": "0.0.9",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/bun": "1.3.14",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web": "^0.0.358",
    "@typescript/typescript-darwin-arm64": "^7.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "browserslist": "^4.29.3",
    "browserslist-to-esbuild": "^2.1.1",
    "bun-types": "^1.4.3",
    "dotenv": "^18.0.7",
    "eslint-plugin-compat": "^7.0.2",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@typescript/typescript-linux-x64": "^7.0.0"
  },
  "overrides": {
    "@osm-editor-kit/osm-data": "0.1.0-alpha.0"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not op_mini all"
  ],
  "patchedDependencies": {
    "@maptiler/geocoding-control@3.0.0": "patches/@maptiler%2Fgeocoding-control@3.0.0.patch"
  },
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
