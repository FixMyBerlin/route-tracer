{
  "name": "route-tracer",
  "version": "0.0.0",
  "private": true,
  "description": "Trace existing routes from reference images into OSM-snapped map geometry",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check-pre-push": "bun run --parallel type-check lint format test-run knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@osm-editor-kit/osm-coverage": "file:../../OSM/street-space-editor/packages/osm-coverage",
    "@osm-editor-kit/osm-data": "file:../../OSM/street-space-editor/packages/osm-data",
    "@osm-editor-kit/osm-map-url": "file:../../OSM/street-space-editor/packages/osm-map-url",
    "@osm-editor-kit/osm-maplibre": "file:../../OSM/street-space-editor/packages/osm-maplibre",
    "@osm-editor-kit/osm-way-chain": "file:../../OSM/street-space-editor/packages/osm-way-chain",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.131.28",
    "clsx": "^2.1.1",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^5.7.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-map-gl": "^8.0.4",
    "route-snapper": "0.4.9",
    "route-snapper-ts": "0.0.9",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.131.28",
    "@types/geojson": "^7946.0.16",
    "@types/lz-string": "^1.5.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript/typescript-darwin-arm64": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "browserslist": "^4.25.3",
    "browserslist-to-esbuild": "^2.1.1",
    "bun-types": "^1.2.20",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "knip": "^5.62.0",
    "oxfmt": "0.56.0",
    "oxlint": "1.70.0",
    "oxlint-config-react-hooks-js": "^1.1.3",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@typescript/typescript-linux-x64": "^7.0.0"
  },
  "overrides": {
    "@osm-editor-kit/osm-data": "file:../../OSM/street-space-editor/packages/osm-data"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not op_mini all"
  ],
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
